# Word Square configuration (see README). Copy to .env to override defaults.

# Storage backend: local (scratch) | static (web/public) | gcs
PUZZLE_STORE=local

# Board generation knobs
# Grid side length (must be 6: a 6x6 double word square)
BOARD_SIZE=6
# Fraction (0..1) of outer-ring letters kept as givens
OUTER_KEEP_RATIO=0.6
# Fraction (0..1) of interior cells blanked out for the player to fill in
INNER_BLANK_RATIO=0.5
# Word familiarity (0..1); 0 = use only the most common words, 1 = full dictionary
WORD_DIFFICULTY=0.75
